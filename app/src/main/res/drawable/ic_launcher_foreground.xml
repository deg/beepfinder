<?xml version="1.0" encoding="utf-8"?>
<!--
  BeepFinder icon foreground: magnifying glass with a bell inside the lens.
  Canvas: 108x108 (adaptive icon). Safe zone: center 72x72 circle.
  Magnifying glass ring: center (48,46), r=22, stroke-width=7.
  Handle: from ring edge (~45° lower-right) extending to (80,80).
  Bell: Material notifications icon path, scaled 1.3x, centered in lens.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <!-- Magnifying glass ring (stroke-only circle) -->
  <path
      android:pathData="M26,46 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0"
      android:fillColor="#00000000"
      android:strokeColor="#FFFFFF"
      android:strokeWidth="7"/>

  <!-- Handle (thick rounded line from ring edge toward lower-right) -->
  <path
      android:pathData="M63,62 L82,81"
      android:fillColor="#00000000"
      android:strokeColor="#FFFFFF"
      android:strokeWidth="9"
      android:strokeLineCap="round"/>

  <!-- Bell: Material notifications icon (24x24 space), scaled 1.3x,
       translated so it centers at approximately (48,46) inside the lens -->
  <group
      android:translateX="30"
      android:translateY="28"
      android:scaleX="1.3"
      android:scaleY="1.3">
    <path
        android:pathData="M12,22c1.1,0 2,-0.9 2,-2h-4c0,1.1 0.9,2 2,2zM18,16v-5c0,-3.07 -1.64,-5.64 -4.5,-6.32V4c0,-0.83 -0.67,-1.5 -1.5,-1.5s-1.5,0.67 -1.5,1.5v0.68C7.63,5.36 6,7.92 6,11v5l-2,2v1h16v-1l-2,-2z"
        android:fillColor="#FFFFFF"/>
  </group>

</vector>
